@article{mangialomini2027safetygates,
  abbr        = {In prep.},
  bibtex_show = {true},
  title       = {Selection Bias in Safety Gates for Fine-Tuned Language Models},
  author      = {Mangialomini, Mateo},
  journal     = {Work in Progress},
  year        = {2027},
  abstract    = {Safety gates are used as a safeguard when language models are fine-tuned, but a gate can only be as reliable as the way its cases are selected. This work studies selection bias in safety gates: how the choice of which cases pass or fail the gate can skew measured safety, and what this implies for evaluating fine-tuned models. The project is at the proposal stage, and a full study is planned for early 2027.}
}

@article{mangialomini2026multiteacher,
  abbr        = {In prep.},
  bibtex_show = {true},
  title       = {Confidence-Weighted Multi-Teacher Knowledge Distillation for Edge Sound Event Detection},
  author      = {Mangialomini, Mateo},
  journal     = {Manuscript in preparation},
  year        = {2026},
  abstract    = {Sound event detection models are accurate but often too large for low-power devices. We study multi-teacher knowledge distillation for compact audio models and propose a confidence-weighted scheme that adjusts how much each teacher contributes to the student. An ensemble of audio teachers (BEATs, PaSST, AST and MobileNetV3) is distilled into an EfficientAT student that reaches 67.05 mAP on FSD50K, above every individual teacher (all below 65.3). Our teacher ensemble alone already surpasses the state of the art by 0.4 mAP with 93.7% fewer parameters. We also map the accuracy-compute trade-off of pruning and INT8 quantization to choose operating points for deployment on a Raspberry Pi 4B.}
}

